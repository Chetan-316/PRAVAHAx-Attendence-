# ==========================================
# PRAVAHAx Attendance Environment Variables
# ==========================================

# Server Port
PORT=4001

# Node Environment
NODE_ENV=production

# Server & Authentication Secrets (Set long random strings in production)
AUTH_SECRET=
JWT_SECRET=
QR_SIGNING_SECRET=

# Dynamic QR Timing Configuration
QR_ROTATION_INTERVAL_SECONDS=4
QR_EXPIRATION_GRACE_SECONDS=4

# Database Connection (Leave empty for local SQLite, or provide Postgres URL for Vercel/production)
DATABASE_URL=
